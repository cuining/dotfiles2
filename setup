#!/bin/bash
# ╓───── dotfiles setup
# ╙────────────────────────────────────── ─ ─
# 跨平台 dotfiles 安装脚本 (macOS + Linux)
#
# usage:
#   ./setup              # 标准安装（包 + 工具 + dotfiles）
#   ./setup --full       # Linux 服务器完整配置（含 swap/用户/SSH/安全）
#   ./setup --minimal    # 仅安装包和 stow dotfiles
#   ./setup --no-build   # 跳过源码编译（neovim, mosh）
#
# 环境变量（用于 --full 模式）:
#   ME=username          # 用户名（默认当前用户）
#   MYHOME=/home/user    # 家目录（默认 $HOME）
#   HOSTNAME_SET=name    # 设置主机名
#   TIMEZONE=Region/City # 时区（默认 America/New_York）
#   SSH_PORT=60806       # SSH 端口
#   CREATE_USER=true     # 创建用户
#   X_UID=10806          # 用户 UID
#   REMOVE_ADMIN=true    # 删除默认 admin 用户

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── source 辅助函数 ───
source "$SCRIPT_DIR/setup.d/common.sh"

# ─── 参数解析 ───
FULL=false
MINIMAL=false
NO_BUILD=false

for arg in "$@"; do
  case "$arg" in
    --full)     FULL=true ;;
    --minimal)  MINIMAL=true ;;
    --no-build) NO_BUILD=true ;;
    --help|-h)
      sed -n '2,/^$/s/^# \?//p' "$0"
      exit 0
      ;;
    *)
      _err "未知参数: $arg"
      exit 1
      ;;
  esac
done

# ─── 开始 ───
_echo "dotfiles setup [$OS / $ARCH_NORMALIZED]"

# ─── 平台包安装 ───
if [[ "$OS" == "macos" ]]; then
  source "$SCRIPT_DIR/setup.d/packages-darwin.sh"
elif [[ "$OS" == "linux" ]]; then
  source "$SCRIPT_DIR/setup.d/packages-linux.sh"
fi

# ─── Linux 服务器配置（仅 --full） ───
if [[ "$FULL" == true && "$OS" == "linux" ]]; then
  source "$SCRIPT_DIR/setup.d/linux-server.sh"
fi

# ─── 工具安装 ───
if [[ "$MINIMAL" == false ]]; then
  if [[ "$NO_BUILD" == true ]]; then
    _warn "跳过源码编译步骤"
  fi
  source "$SCRIPT_DIR/setup.d/tools.sh"
fi

# ─── Dotfiles 部署 ───
source "$SCRIPT_DIR/setup.d/dotfiles.sh"

# ─── ASCII art 工具 ───
if [[ "$MINIMAL" == false ]]; then
  source "$SCRIPT_DIR/setup.d/ascii-art.sh"
fi

# ─── 完成 ───
_echo "setup complete"
_ok "平台: $OS ($ARCH_NORMALIZED)"
_ok "dotfiles: $DOTFILES_DIR"
if [[ "$OS" == "linux" && "$FULL" == true ]]; then
  _warn "建议重启系统: sudo reboot"
fi
